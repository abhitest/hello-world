# ─── Webflow OAuth ────────────────────────────────────────────
WEBFLOW_CLIENT_ID=your_webflow_client_id
WEBFLOW_CLIENT_SECRET=your_webflow_client_secret

# ─── App URLs ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001
DESIGNER_EXTENSION_URL=http://localhost:1337

# ─── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/metamind?schema=public

# ─── Redis (for BullMQ job queue) ─────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key

# ─── Stripe (billing) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_PRO=price_your_pro_price_id
STRIPE_PRICE_AGENCY=price_your_agency_price_id

# ─── App Config ──────────────────────────────────────────────
NODE_ENV=development
