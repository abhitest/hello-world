generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id               String   @id @default(cuid())
  webflowUserId    String   @unique @map("webflow_user_id")
  accessToken      String   @map("access_token")
  refreshToken     String?  @map("refresh_token")
  tokenExpiresAt   DateTime? @map("token_expires_at")
  email            String?
  stripeCustomerId String?  @unique @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  sites           Site[]
  usageRecords    UsageRecord[]
  subscriptions   Subscription[]

  @@map("accounts")
}

model Site {
  id          String   @id @default(cuid())
  webflowId   String   @unique @map("webflow_id")
  name        String
  accountId   String   @map("account_id")
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  settings    SiteSettings?

  @@map("sites")
}

model SiteSettings {
  id                    String @id @default(cuid())
  siteId                String @unique @map("site_id")
  site                  Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  brandName             String @default("") @map("brand_name")
  tone                  String @default("professional")
  targetKeywords        String @default("") @map("target_keywords")
  maxTitleLength        Int    @default(60) @map("max_title_length")
  maxDescriptionLength  Int    @default(155) @map("max_description_length")
  language              String @default("en")

  @@map("site_settings")
}

model UsageRecord {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        String   // "meta_generation" | "alt_text_generation"
  tokens      Int      @default(0)
  count       Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([accountId, createdAt])
  @@map("usage_records")
}



model Subscription {
  id                    String   @id @default(cuid())
  accountId             String   @map("account_id")
  account               Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stripeSubscriptionId  String   @unique @map("stripe_subscription_id")
  stripeCustomerId      String   @map("stripe_customer_id")
  stripePriceId         String   @map("stripe_price_id")
  status                String   // "active" | "trialing" | "past_due" | "canceled" | "incomplete"
  currentPeriodStart    DateTime @map("current_period_start")
  currentPeriodEnd      DateTime @map("current_period_end")
  cancelAtPeriodEnd     Boolean  @default(false) @map("cancel_at_period_end")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([accountId])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}
